<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Sortir{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <!-- Favicon -->
    <link rel="icon" href="{{ asset('img/icon/favicon.ico') }}" sizes="any">
    <link rel="icon" type="image/png" sizes="256x256" href="{{ asset('img/icon/favicon-256x256.png') }}">
    <!-- Apple Touch Icon (iOS) -->
    <link rel="apple-touch-icon" href="{{ asset('img/icon/apple-icon-180x180.png') }}">
    <!-- Android / Chrome -->
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('img/icon/android-icon-192x192.png') }}">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-github-darkest">
<header>
    {% include("_navbar.html.twig") %}
</header>
<main class="mx-auto max-w-screen-xl px-4 pt-20">
    {% block body %}
    {% endblock %}
</main>
</body>
</html>
