<!DOCTYPE html>
<html lang="fr" class="min-h-screen">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Sortir{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <!-- Favicon -->
    <link rel="icon" href="{{ asset('img/icon/favicon.ico') }}" sizes="any">
    <link rel="icon" type="image/png" sizes="256x256" href="{{ asset('img/icon/favicon-256x256.png') }}">
    <!-- Apple Touch Icon (iOS) -->
    <link rel="apple-touch-icon" href="{{ asset('img/icon/apple-icon-180x180.png') }}">
    <!-- Android / Chrome -->
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('img/icon/android-icon-192x192.png') }}">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-github-darkest min-h-screen flex flex-col">
<header>
    {% include("_navbar.html.twig") %}
</header>
<main class="mx-auto max-w-screen-xl px-4 pt-20 flex-1 w-full mb-8">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% if label == 'success' %}
                <div
                    class="max-w-xl mx-auto bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-4"
                    role="alert">
                    {{ message }}
                </div>
            {% elseif label == 'error' %}
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-4" role="alert">
                    {{ message }}
                </div>
            {% else %}
                <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded-lg mb-4" role="alert">
                    {{ message }}
                </div>
            {% endif %}
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>
<footer class="bg-github-dark-gray text-heading text-center py-3 mt-auto border-t-3 border-github-dark-blue">
    <div class="max-w-screen-xl mx-auto px-4">
        &copy; ENI {{ "now"|date("Y") }}
    </div>
</footer>
</body>
</html>
