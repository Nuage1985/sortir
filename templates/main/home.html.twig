{% extends 'base.html.twig' %}

{% block title %}
    Accueil | {{ parent() }}
{% endblock %}

{% block flash_messages %}{% endblock %}

{% block body %}

    {# Si l'utilisateur n'est pas connecter, formulaire de login #}
    {% if not app.user %}
        <form class="max-w-sm mx-auto bg-github-dark-gray p-4 m-8 rounded-lg border-3 border-github-dark-blue"
              action="{{ path('login_check') }}"
              method="post">
            {% if error %}
                <div class="text-red-500 mb-4">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <div class="mb-5">
                <label for="username" class="block mb-2.5 text-sm font-medium text-heading">Identifiant (e-mail ou
                    pseudonyme)</label>
                <input type="text" value="{{ last_username }}" name="_username" id="username"
                       class="bg-gray-800 border border-gray-600 text-heading text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full px-3 py-2.5 placeholder:text-gray-400"
                       autocomplete="username" required autofocus/>
            </div>
            <div class="mb-5">
                <label for="password" class="block mb-2.5 text-sm font-medium text-heading">Mot de passe</label>
                <input type="password" name="_password" id="password"
                       class="bg-gray-800 border border-gray-600 text-heading text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full px-3 py-2.5 placeholder:text-gray-400"
                       autocomplete="current-password" required/>
            </div>
            <div class="mb-5">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label class="text-heading text-sm" for="_remember_me">Se souvenir de moi</label>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit"
                    class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-500 font-medium rounded-lg text-sm px-4 py-2.5 focus:outline-none">
                Se connecter
            </button>
        </form>
    {% endif %}

    {# Si l'utilisateur est connecté #}
    {% if is_granted('ROLE_USER') %}

        {# Affichage des infos utilisateur + date et espace pour les messages flash #}
        <div class="flex flex-wrap items-center justify-between gap-4 m-4">
            <div>
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {% if label == 'success' %}
                            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg"
                                 role="alert">
                                {{ message }}
                            </div>
                        {% elseif label == 'error' %}
                            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg"
                                 role="alert">
                                {{ message }}
                            </div>
                        {% else %}
                            <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded-lg"
                                 role="alert">
                                {{ message }}
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            </div>
            <div
                class="bg-github-dark-gray text-default p-4 w-fit rounded-lg border-3 border-github-dark-blue flex items-center justify-between gap-4">
                <div>
                    <p class="mb-1">Date du jour : {{ "now"|date("d/m/Y") }}</p>
                    <p>Profil : {{ app.user.prenom }} {{ app.user.nom | first }}.</p>
                </div>
                {# Photo de profil si existante ou image par défaut #}
                {% if app.user.filename %}
                    <img class="w-10 h-10 rounded-full ring-3 ring-github-dark-blue flex-shrink-0"
                         src="{{ asset(app_public_images_directory ~'/'~app.user.filename) }}"
                         alt="Photo de profil de {{ app.user.pseudo }}">
                {% else %}
                    <img class="w-10 h-10 rounded-full ring-3 ring-github-dark-blue flex-shrink-0"
                         src="{{ asset('img/default_profile.png') }}"
                         alt="Silhouette de profil utilisateur, par défaut">
                {% endif %}
            </div>
        </div>

        {# Filtres liste des sorties #}
        <form method="get" action="{{ path('liste') }}"
              class="mb-6 flex flex-wrap items-center gap-3 rounded-lg border border-gray-600 bg-github-dark-gray p-4 text-heading">
            <label for="campusId">Campus : </label>
            <select name="campusId" id="campusId"
                    class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading focus:outline-none">
                {% for campus in campusList|default([]) %}
                    <option value="{{ campus.id }}"
                        {% if campusSelectionne is defined and campus.id == campusSelectionne.id %}
                    selected
                        {% endif %}>
                        {{ campus.nom }}
                    </option>
                {% endfor %}
            </select>

            <label for="nom" class="text-sm">Le nom de la sortie contient</label>
            <input type="search" name="nom" id="nom" placeholder="search" value="{{ filtres.nom|default('') }}"
                   class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading placeholder:text-gray-400 focus:outline-none">

            <label for="dateDebut" class="text-sm">Entre</label>
            <input type="date" name="dateDebut" id="dateDebut" value="{{ filtres.dateDebut|default('') }}"
                   class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading focus:outline-none">
            <label for="dateFin" class="text-sm">et</label>
            <input type="date" name="dateFin" id="dateFin" value="{{ filtres.dateFin|default('') }}"
                   class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading focus:outline-none">

            <label class="text-sm"><input type="checkbox" name="organisateur" value="1"
                                          class="h-4 w-4 rounded text-blue-600 bg-gray-700 border-gray-500" {{ filtres.organisateur|default(false) ? 'checked' }}>
                Sorties dont je suis l'organisateur/trice</label>
            <label class="text-sm"><input type="checkbox" name="inscrit" id="inscrit" value="1"
                                          class="h-4 w-4 rounded text-blue-600 bg-gray-700 border-gray-500" {{ filtres.inscrit|default(false) ? 'checked' }}>
                Sorties auxquelles je suis inscrit/e</label>
            <label class="text-sm"><input type="checkbox" name="nonInscrit" id="nonInscrit" value="1"
                                          class="h-4 w-4 rounded text-blue-600 bg-gray-700 border-gray-500" {{ filtres.nonInscrit|default(false) ? 'checked' }}>
                Sorties auxquelles je ne suis pas inscrit/e</label>
            <label class="text-sm"><input type="checkbox" name="terminees" value="1"
                                          class="h-4 w-4 rounded text-blue-600 bg-gray-700 border-gray-500" {{ filtres.terminees|default(false) ? 'checked' }}>
                Sorties terminées</label>

            <button type="submit"
                    class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Rechercher
            </button>
        </form>

        <div
            class="relative overflow-x-auto bg-github-dark-gray text-heading shadow-sm rounded-lg border border-gray-600">
            <table class="w-full text-sm text-left text-heading">
                <thead class="bg-gray-700 border-b border-gray-600">
                <tr>
                    <th scope="col" class="px-6 py-3 font-medium">Nom de la sortie</th>
                    <th scope="col" class="px-6 py-3 font-medium">Date de la sortie</th>
                    <th scope="col" class="px-6 py-3 font-medium">Clôture</th>
                    <th scope="col" class="px-6 py-3 font-medium">Inscrit(s) / Places</th>
                    <th scope="col" class="px-6 py-3 font-medium">État</th>
                    <th scope="col" class="px-6 py-3 font-medium">Inscrit</th>
                    <th scope="col" class="px-6 py-3 font-medium">Organisateur</th>
                    <th scope="col" class="px-6 py-3 font-medium">Action</th>
                </tr>
                </thead>
                <tbody>
                {% for sortie in sorties|default([]) %}
                    {% set estOrganisateur = sortie.organisateur == app.user %}
                    {% set estInscrit = sortie.participants.contains(app.user) %}
                    {% if sortie.etat.value not in ['Historise', 'Historisee'] and sortie.etat.libelle != 'Historisée' %}
                        <tr class="border-b border-gray-600 odd:bg-github-dark-gray even:bg-gray-800">
                            <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                {{ sortie.nom }}
                            </th>
                            <td class="px-6 py-4">{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</td>
                            <td class="px-6 py-4">
                                {{ sortie.dateLimiteInscription ? sortie.dateLimiteInscription|date('d/m/Y') : '-' }}
                            </td>
                            <td class="px-6 py-4">{{ sortie.participants|length }} / {{ sortie.nbInscriptionMax }}</td>
                            <td class="px-6 py-4">{{ sortie.etat.libelle }}</td>
                            <td class="px-6 py-4">{{ estInscrit ? 'X' : '' }}</td>
                            <td class="px-6 py-4">
                                <a href="{{ path('profile_details', { id: sortie.organisateur.id }) }}"
                                   class="font-medium text-blue-500 hover:underline">
                                    {{ sortie.organisateur.prenom }} {{ sortie.organisateur.nom }}
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                <a href="{{ path('sortie_detail', { id: sortie.id }) }}"
                                   class="font-medium text-blue-500 hover:underline">Afficher</a>
                                {% if estOrganisateur and sortie.etat.value == 'EnCreation' %}
                                    <br><a href="{{ path('sortie_edit', {id: sortie.id}) }}"
                                           class="font-medium text-blue-500 hover:underline">Modifier</a>
                                    <form method="post" action="{{ path('publier_sortie', { id: sortie.id }) }}">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('publish_sortie_' ~ sortie.id) }}">
                                        <button type="submit" class="font-medium text-blue-500 hover:underline">Publier
                                        </button>
                                    </form>
                                {% endif %}

                                {% if sortie.etat.value == 'Ouverte' and not estInscrit and sortie.participants|length < sortie.nbInscriptionMax and (sortie.dateLimiteInscription is null or sortie.dateLimiteInscription > date()) %}
                                    <br>
                                    <form method="post" action="{{ path('sortie_inscrire', { id: sortie.id }) }}">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('inscrire_sortie_' ~ sortie.id) }}">
                                        <button type="submit" class="font-medium text-blue-500 hover:underline">
                                            S'inscrire
                                        </button>
                                    </form>
                                {% endif %}

                                {% if estOrganisateur and sortie.etat.value == 'Ouverte' %}
                                    <br><a href="{{ path('sortie_annuler', { id: sortie.id}) }}"
                                           class="font-medium text-orange-500 hover:underline">Annuler</a>
                                {% endif %}

                                {% if estInscrit and sortie.etat.value == 'Ouverte' %}
                                    <br>
                                    <form method="post" action="{{ path('sortie_desister', { id: sortie.id }) }}">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('desister_sortie_' ~ sortie.id) }}">
                                        <button type="submit" class="font-medium text-blue-500 hover:underline">Se
                                            désister
                                        </button>
                                    </form>
                                {% endif %}

                            </td>
                        </tr>
                    {% endif %}
                {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-4 text-center">Aucune sortie à afficher.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {# Pagination #}
        {% if totalPages > 1 %}
            {% set queryParams %}
                {% if campusSelectionne is defined and campusSelectionne is not null %}&campusId={{ campusSelectionne.id }}{% endif %}
                {% if filtres.nom %}&nom={{ filtres.nom }}{% endif %}
                {% if filtres.dateDebut %}&dateDebut={{ filtres.dateDebut }}{% endif %}
                {% if filtres.dateFin %}&dateFin={{ filtres.dateFin }}{% endif %}
                {% if filtres.organisateur %}&organisateur=1{% endif %}
                {% if filtres.inscrit %}&inscrit=1{% endif %}
                {% if filtres.etat %}&terminees=1{% endif %}
            {% endset %}

            <nav class="flex items-center justify-center gap-1 mt-6" aria-label="Pagination">
                {# Bouton Précédent (caché sur mobile) #}
                {% if currentPage > 1 %}
                    <a href="{{ path('liste') }}?page={{ currentPage - 1 }}{{ queryParams }}"
                       class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-400 hover:bg-gray-700 hover:text-white sm:flex">
                        <span class="sr-only">Précédent</span>
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                                  clip-rule="evenodd"></path>
                        </svg>
                    </a>
                {% else %}
                    <span
                        class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-600 cursor-not-allowed sm:flex">
                        <span class="sr-only">Précédent</span>
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                                  clip-rule="evenodd"></path>
                        </svg>
                    </span>
                {% endif %}

                {# Numéros de page #}
                {% for i in 1..totalPages %}
                    {% if i == currentPage %}
                        <span
                            class="rounded-lg border border-blue-500 bg-blue-600 px-4 py-2 text-sm font-medium text-white">
                            {{ i }}
                        </span>
                    {% else %}
                        <a href="{{ path('liste') }}?page={{ i }}{{ queryParams }}"
                           class="rounded-lg border border-gray-600 bg-github-dark-gray px-4 py-2 text-sm font-medium text-gray-400 hover:bg-gray-700 hover:text-white">
                            {{ i }}
                        </a>
                    {% endif %}
                {% endfor %}

                {# Bouton Suivant (caché sur mobile) #}
                {% if currentPage < totalPages %}
                    <a href="{{ path('liste') }}?page={{ currentPage + 1 }}{{ queryParams }}"
                       class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-400 hover:bg-gray-700 hover:text-white sm:flex">
                        <span class="sr-only">Suivant</span>
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                  clip-rule="evenodd"></path>
                        </svg>
                    </a>
                {% else %}
                    <span
                        class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-600 cursor-not-allowed sm:flex">
                        <span class="sr-only">Suivant</span>
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                  clip-rule="evenodd"></path>
                        </svg>
                    </span>
                {% endif %}
            </nav>
        {% endif %}

        <div class="mt-4">
            <a href="{{ path('sortie_creer') }}"
               class="inline-block text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-500 font-medium rounded-lg text-sm px-4 py-2.5 focus:outline-none">
                Créer une sortie
            </a>
        </div>

        <script>
            (() => {
                const inscrit = document.getElementById('inscrit');
                const nonInscrit = document.getElementById('nonInscrit');

                // Les deux cases sont mutuellement exclusives
                if (inscrit && nonInscrit) {
                    inscrit.addEventListener('change', () => {
                        if (inscrit.checked) nonInscrit.checked = false;
                    });
                    nonInscrit.addEventListener('change', () => {
                        if (nonInscrit.checked) inscrit.checked = false;
                    });
                }
            })();
        </script>
    {% endif %}
{% endblock %}
