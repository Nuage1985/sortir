{% extends 'base.html.twig' %}

{% block title %}
    Accueil | {{ parent() }}
{% endblock %}

{% block body %}
    {% if not app.user %}
        <form class="max-w-sm mx-auto bg-github-dark-gray p-4 m-8 rounded-lg border-3 border-github-dark-blue"
              action="{{ path('login_check') }}"
              method="post">
            {% if error %}
                <div class="text-red-500 mb-4">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <div class="mb-5">
                <label for="username" class="block mb-2.5 text-sm font-medium text-heading">Identifiant (e-mail ou
                    pseudonyme)</label>
                <input type="text" value="{{ last_username }}" name="_username" id="username"
                       class="bg-gray-800 border border-gray-600 text-heading text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full px-3 py-2.5 placeholder:text-gray-400"
                       autocomplete="username" required autofocus/>
            </div>
            <div class="mb-5">
                <label for="password" class="block mb-2.5 text-sm font-medium text-heading">Mot de passe</label>
                <input type="password" name="_password" id="password"
                       class="bg-gray-800 border border-gray-600 text-heading text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full px-3 py-2.5 placeholder:text-gray-400"
                       autocomplete="current-password" required/>
            </div>
            <div class="mb-5">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label class="text-heading text-sm" for="_remember_me">Se souvenir de moi</label>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit"
                    class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-500 font-medium rounded-lg text-sm px-4 py-2.5 focus:outline-none">
                Se connecter
            </button>
        </form>
    {% endif %}

    {% if is_granted('ROLE_USER') %}
        <div class="bg-github-dark-gray text-default m-4 p-4 w-fit ml-auto rounded-lg border-3 border-github-dark-blue flex items-center justify-between gap-4">
            <div>
                <p class="mb-1">Date du jour : {{ "now"|date("d/m/Y") }}</p>
                <p>Profil : {{ app.user.prenom }} {{ app.user.nom | first }}.</p>
            </div>
            {% if app.user.filename %}
                <img class="w-10 h-10 rounded-full ring-3 ring-github-dark-blue flex-shrink-0"
                     src="{{ asset(app_public_images_directory ~'/'~app.user.filename) }}"
                     alt="Photo de profil de {{ app.user.pseudo }}">
            {% else %}
                <img class="w-10 h-10 rounded-full ring-3 ring-github-dark-blue flex-shrink-0"
                     src="{{ asset('img/default_profile.png') }}"
                     alt="Silhouette de profil utilisateur, par défaut">
            {% endif %}
        </div>
        <div
            class="relative overflow-x-auto bg-github-dark-gray text-heading shadow-sm rounded-lg border border-gray-600">
            <table class="w-full text-sm text-left text-heading">
