{% extends 'base.html.twig' %}

{% block title %}
    Liste des Campus | {{ parent() }}
{% endblock %}

{% block body %}

    {# Formulaire de recherche par nom #}
    <form method="get" action="{{ path('admin_campus_list') }}"
          class="mb-6 flex flex-wrap items-center gap-3 rounded-lg border border-gray-600 bg-github-dark-gray p-4 text-heading">
        <label for="nom" class="text-sm">Le nom du campus contient</label>
        <input type="search" name="nom" id="nom" placeholder="Rechercher une ville" value="{{ nom|default('') }}"
               class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading placeholder:text-gray-400 focus:outline-none">

        <button type="submit"
                class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Rechercher
        </button>
    </form>

    {# Tableau des campus #}
    <div class="overflow-x-auto bg-github-dark-gray text-heading shadow-sm rounded-lg border border-gray-600">
        <table class="w-full text-sm text-left text-heading">
            <thead class="bg-gray-700 border-b border-gray-600">
            <tr>
                <th scope="col" class="px-6 py-3 font-medium">Nom</th>
                <th scope="col" class="px-6 py-3 font-medium">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for campus in campuses|default([]) %}
                <tr class="border-b border-gray-600 odd:bg-github-dark-gray even:bg-gray-800">
                    <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                        {{ campus.nom }}
                    </th>
                    <td class="px-6 py-4">
                        <a href="{{ path('admin_campus_edit', { id: campus.id }) }}"
                           class="font-medium text-blue-500 hover:underline">Modifier</a><br>
                        {% if campus.id not in nonDeletableCampuses|default([]) %}
                            <button type="button"
                                    class="font-medium text-red-500 hover:underline"
                                    data-campus-id="{{ campus.id }}"
                                    data-campus-nom="{{ campus.nom }}"
                                    data-delete-url="{{ path('admin_campus_delete', { id: campus.id }) }}"
                                    data-csrf-token="{{ csrf_token('delete_campus_' ~ campus.id) }}"
                                    onclick="openDeleteModal(this)">
                                Supprimer
                            </button>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="px-6 py-4 text-center">Aucun campus à afficher.</td>
                </tr>
            {% endfor %}

            {# Ligne d'ajout d'une nouveau campus #}
            <tr class="border-b border-gray-600 bg-gray-700">
                <td colspan="3" class="px-6 py-4 text-center">
                    {{ form_start(addCampusForm, {'attr': {'class': 'flex flex-wrap items-center justify-center gap-2'}}) }}
                    <div>
                        <label for="{{ addCampusForm.nom.vars.id }}" class="sr-only">Nom du campus</label>
                        {{ form_widget(addCampusForm.nom, {'attr': {'class': 'bg-gray-800 border border-gray-600 text-heading text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 px-3 py-2 placeholder:text-gray-400', 'placeholder': 'Nom du campus'}}) }}
                        {{ form_errors(addCampusForm.nom) }}
                    </div>
                    {{ form_widget(addCampusForm.save) }}
                    {{ form_end(addCampusForm) }}
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    {# Pagination #}
    {% if totalPages > 1 %}
        {% set queryParams %}
            {% if nom %}&nom={{ nom }}{% endif %}
        {% endset %}

        <nav class="flex items-center justify-center gap-1 mt-6" aria-label="Pagination">
            {# Bouton Précédent (caché sur mobile) #}
            {% if currentPage > 1 %}
                <a href="{{ path('admin_campus_list') }}?page={{ currentPage - 1 }}{{ queryParams }}"
                   class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-400 hover:bg-gray-700 hover:text-white sm:flex">
                    <span class="sr-only">Précédent</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                              clip-rule="evenodd"></path>
                    </svg>
                </a>
            {% else %}
                <span
                    class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-600 cursor-not-allowed sm:flex">
                    <span class="sr-only">Précédent</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                              clip-rule="evenodd"></path>
                    </svg>
                </span>
            {% endif %}

            {# Numéros de page #}
            {% for i in 1..totalPages %}
                {% if i == currentPage %}
                    <span
                        class="rounded-lg border border-blue-500 bg-blue-600 px-4 py-2 text-sm font-medium text-white">
                        {{ i }}
                    </span>
                {% else %}
                    <a href="{{ path('admin_campus_list') }}?page={{ i }}{{ queryParams }}"
                       class="rounded-lg border border-gray-600 bg-github-dark-gray px-4 py-2 text-sm font-medium text-gray-400 hover:bg-gray-700 hover:text-white">
                        {{ i }}
                    </a>
                {% endif %}
            {% endfor %}

            {# Bouton Suivant (caché sur mobile) #}
            {% if currentPage < totalPages %}
                <a href="{{ path('admin_campus_list') }}?page={{ currentPage + 1 }}{{ queryParams }}"
                   class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-400 hover:bg-gray-700 hover:text-white sm:flex">
                    <span class="sr-only">Suivant</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                              clip-rule="evenodd"></path>
                    </svg>
                </a>
            {% else %}
                <span
                    class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-600 cursor-not-allowed sm:flex">
                    <span class="sr-only">Suivant</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                              clip-rule="evenodd"></path>
                    </svg>
                </span>
            {% endif %}
        </nav>
    {% endif %}

    {# Retour à la page d'administration #}
    <div class="mt-8 flex flex-col items-center sm:flex-row sm:justify-center">
        <a href="{{ path('admin_dashboard') }}"
           class="w-full rounded-lg bg-yellow-600 px-4 py-2 text-sm font-medium text-default text-center hover:bg-yellow-700 sm:w-auto">
            Retour
        </a>
    </div>

    {# Modal de confirmation de suppression #}
    <div id="deleteModal" tabindex="-1" aria-hidden="true"
         class="hidden fixed inset-0 z-50 flex items-center justify-center w-full h-full bg-black/60">
        <div class="relative p-4 w-full max-w-md">
            <div class="relative bg-github-dark-gray rounded-lg shadow-sm border border-gray-600">
                <div class="p-6 text-center">
                    <button type="button"
                            class="text-gray-400 hover:text-heading absolute top-3 right-3 text-sm font-medium"
                            onclick="closeDeleteModal()">
                        &times;
                    </button>
                    <svg class="mx-auto mb-4 w-12 h-12 text-orange-500" aria-hidden="true" fill="none"
                         stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 9v3m0 3v.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                    <h3 class="mb-2 text-lg font-medium text-heading">
                        Êtes-vous sûr de vouloir supprimer <span id="deleteModalCampusName"></span> ?
                    </h3>
                    <p class="mb-5 text-sm text-gray-400">Cette action est irréversible.</p>
                    <form id="deleteModalForm" method="post">
                        <input type="hidden" name="_token" id="deleteModalToken">
                        <div class="flex gap-3 justify-center">
                            <button type="button"
                                    class="text-heading bg-gray-700 border border-gray-600 hover:bg-gray-600 font-medium rounded-lg text-sm px-5 py-2.5"
                                    onclick="closeDeleteModal()">
                                Non, annuler
                            </button>
                            <button type="submit"
                                    class="text-white bg-red-600 hover:bg-red-700 font-medium rounded-lg text-sm px-5 py-2.5">
                                Oui, supprimer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openDeleteModal(btn) {
            document.getElementById('deleteModalCampusName').textContent = btn.dataset.campusNom;
            document.getElementById('deleteModalToken').value = btn.dataset.csrfToken;
            document.getElementById('deleteModalForm').action = btn.dataset.deleteUrl;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }

        // Fermer le modal en cliquant en dehors
        document.getElementById('deleteModal').addEventListener('click', function (e) {
            if (e.target === this) closeDeleteModal();
        });
        // Fermer le modal avec la touche Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeDeleteModal();
        });
    </script>
{% endblock %}

