{% extends 'base.html.twig' %}

{% block title %}
    Modifier {{ ville.nom}} | {{ parent() }}
{% endblock %}

{% block body %}

    <div class="max-w-2xl mx-auto bg-github-dark-gray p-6 rounded-lg border border-gray-600 text-heading">
        <h1 class="text-heading text-center mb-4">Modifier la ville : <br>{{ ville.nom }}</h1>

        {{ form_start(form) }}
        <div class="mb-5">
            <span class="text-red-500 text-xs mb-0.5">*</span>
            {{ form_label(form.nom, null, {'label_attr': {'class': 'block mb-2.5 text-sm font-medium text-heading'}}) }}
            {{ form_widget(form.nom) }}
            {{ form_errors(form.nom) }}
        </div>
        <div class="mb-5">
            <span class="text-red-500 text-xs mb-0.5">*</span>
            {{ form_label(form.codePostal, null, {'label_attr': {'class': 'block mb-2.5 text-sm font-medium text-heading'}}) }}
            {{ form_widget(form.codePostal) }}
            {{ form_errors(form.codePostal) }}
        </div>
        <p class="mb-4 text-xs text-gray-400 mt-1"><span class="text-red-500 text-xs mb-0.5">(*)</span> Les champs marqués d'un astérisque sont obligatoires.</p>
        <div class="flex gap-3">
            <button type="submit"
                    class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-500 font-medium rounded-lg text-sm px-4 py-2.5 focus:outline-none">
                Enregistrer
            </button>
            <a href="{{ path('admin_cities_list') }}"
               class="text-white bg-gray-600 hover:bg-gray-700 focus:ring-4 focus:ring-gray-500 font-medium rounded-lg text-sm px-4 py-2.5 focus:outline-none">
                Annuler
            </a>
        </div>
        {{ form_end(form) }}
    </div>

{% endblock %}
