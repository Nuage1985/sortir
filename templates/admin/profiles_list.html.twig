{% extends 'base.html.twig' %}

{% block title %}
    Liste des participants | {{ parent() }}
{% endblock %}

{% block body %}

    {# Formulaire de recherche #}
    <form method="get" action="{{ path('admin_profiles_list') }}"
          class="mb-6 rounded-lg border border-gray-600 bg-github-dark-gray p-4 text-heading">

        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3">

            <div class="w-full sm:flex-1">
                <label for="nom" class="sr-only">Nom</label>
                <input type="search" name="nom" id="nom" placeholder="Nom" value="{{ filtres.nom|default('') }}"
                       class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading placeholder:text-gray-400 focus:outline-none">
            </div>

            <div class="w-full sm:flex-1">
                <label for="prenom" class="sr-only">Prénom</label>
                <input type="search" name="prenom" id="prenom" placeholder="Prénom"
                       value="{{ filtres.prenom|default('') }}"
                       class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading placeholder:text-gray-400 focus:outline-none">
            </div>

            <div class="w-full sm:flex-1">
                <label for="pseudo" class="sr-only">Pseudo</label>
                <input type="search" name="pseudo" id="pseudo" placeholder="Pseudo"
                       value="{{ filtres.pseudo|default('') }}"
                       class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading placeholder:text-gray-400 focus:outline-none">
            </div>

            <div class="w-full sm:flex-1">
                <label for="actif" class="sr-only">Statut</label>
                <select name="actif" id="actif"
                        class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-heading focus:outline-none">
                    <option value=""
                            {% if not (filtres.actif is same as(true) or filtres.actif is same as(false)) %}selected{% endif %}>
                        Tous
                    </option>
                    <option value="1" {% if filtres.actif is same as(true) %}selected{% endif %}>Actifs</option>
                    <option value="0" {% if filtres.actif is same as(false) %}selected{% endif %}>Inactifs</option>
                </select>
            </div>

        </div>

        {# Boutons / Liens #}
        <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:justify-between">
            <button type="submit"
                    class="w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-2 text-sm
                           font-medium text-default text-center hover:bg-blue-700 sm:w-auto">
                Rechercher
            </button>
            <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row sm:gap-4">
                <a href="{{ path('admin_profile_create') }}"
                   class="w-full rounded-lg bg-purple-600 px-4 py-2 text-sm
                          font-medium text-default text-center hover:bg-purple-800 sm:w-auto">
                    Nouveau profil
                </a>
                <a href="{{ path('admin_dashboard') }}"
                   class="w-full rounded-lg bg-yellow-600 px-4 py-2 text-sm
                          font-medium text-default text-center hover:bg-yellow-700 sm:w-auto">
                    Retour
                </a>
            </div>
        </div>
    </form>

    {# Tableau des profils #}
    <div class="overflow-x-auto bg-github-dark-gray text-heading shadow-sm rounded-lg border border-gray-600">
        <table class="w-full text-sm text-left text-heading">
            <thead class="bg-gray-700 border-b border-gray-600">
            <tr>
                <th scope="col" class="px-6 py-3 font-medium">Pseudo</th>
                <th scope="col" class="px-6 py-3 font-medium">Nom</th>
                <th scope="col" class="px-6 py-3 font-medium">Prénom</th>
                <th scope="col" class="px-6 py-3 font-medium">Mail</th>
                <th scope="col" class="px-6 py-3 font-medium">Campus</th>
                <th scope="col" class="px-6 py-3 font-medium">Actif</th>
                <th scope="col" class="px-6 py-3 font-medium">Action</th>
            </tr>
            </thead>
            <tbody>
            {% for participant in participants|default([]) %}
                <tr class="border-b border-gray-600 odd:bg-github-dark-gray even:bg-gray-800">
                    <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                        {{ participant.pseudo }}
                    </th>
                    <td class="px-6 py-4">{{ participant.nom }}</td>
                    <td class="px-6 py-4">{{ participant.prenom }}</td>
                    <td class="px-6 py-4">{{ participant.mail }}</td>
                    <td class="px-6 py-4">{{ participant.campus.nom ?? '-' }}</td>
                    <td class="px-6 py-4">
                        {% if participant.actif %}
                            <span class="text-green-400">Oui</span>
                        {% else %}
                            <span class="text-red-400">Non</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        <a href="{{ path('admin_profile_edit', {id: participant.id}) }}"
                           class="cursor-pointer font-medium text-blue-500 hover:underline">
                            Modifier
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="px-6 py-4 text-center">Aucun utilisateur à afficher.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    {% if totalPages > 1 %}
        {# Construire les paramètres de query pour conserver les filtres #}
        {% set queryParams %}
            {% if filtres.nom %}&nom={{ filtres.nom }}{% endif %}
            {% if filtres.prenom %}&prenom={{ filtres.prenom }}{% endif %}
            {% if filtres.pseudo %}&pseudo={{ filtres.pseudo }}{% endif %}
            {% if filtres.actif is same as(true) %}&actif=1{% elseif filtres.actif is same as(false) %}&actif=0{% endif %}
        {% endset %}

        <nav class="flex items-center justify-center gap-1 mt-6" aria-label="Pagination">
            {# Bouton Précédent (caché sur mobile) #}
            {% if currentPage > 1 %}
                <a href="{{ path('admin_profiles_list') }}?page={{ currentPage - 1 }}{{ queryParams }}"
                   class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-400 hover:bg-gray-700 hover:text-white sm:flex">
                    <span class="sr-only">Précédent</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                              clip-rule="evenodd"></path>
                    </svg>
                </a>
            {% else %}
                <span
                    class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-600 cursor-not-allowed sm:flex">
                    <span class="sr-only">Précédent</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                              clip-rule="evenodd"></path>
                    </svg>
                </span>
            {% endif %}

            {# Numéros de page #}
            {% for i in 1..totalPages %}
                {% if i == currentPage %}
                    <span
                        class="rounded-lg border border-blue-500 bg-blue-600 px-4 py-2 text-sm font-medium text-white">
                        {{ i }}
                    </span>
                {% else %}
                    <a href="{{ path('admin_profiles_list') }}?page={{ i }}{{ queryParams }}"
                       class="rounded-lg border border-gray-600 bg-github-dark-gray px-4 py-2 text-sm font-medium text-gray-400 hover:bg-gray-700 hover:text-white">
                        {{ i }}
                    </a>
                {% endif %}
            {% endfor %}

            {# Bouton Suivant (caché sur mobile) #}
            {% if currentPage < totalPages %}
                <a href="{{ path('admin_profiles_list') }}?page={{ currentPage + 1 }}{{ queryParams }}"
                   class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-400 hover:bg-gray-700 hover:text-white sm:flex">
                    <span class="sr-only">Suivant</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                              clip-rule="evenodd"></path>
                    </svg>
                </a>
            {% else %}
                <span
                    class="hidden rounded-lg border border-gray-600 bg-github-dark-gray p-2 text-gray-600 cursor-not-allowed sm:flex">
                    <span class="sr-only">Suivant</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                              clip-rule="evenodd"></path>
                    </svg>
                </span>
            {% endif %}
        </nav>
    {% endif %}
{% endblock %}
